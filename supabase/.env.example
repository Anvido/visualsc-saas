# Supabase Environment Variables for Local Development
# Copy this to supabase/.env.local and fill with your values

# Local Supabase Studio (for local development)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your_local_anon_key_here

# For linking to remote Supabase project
# SUPABASE_REMOTE_PROJECT_ID=your_project_id
# SUPABASE_REMOTE_DB_URL=postgresql://...
