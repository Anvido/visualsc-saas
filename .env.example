# Supabase Configuration
# Get these values from https://app.supabase.com/projects/[project]/settings/api
# 
# DO NOT commit .env.local to version control
# DO NOT share these credentials publicly

# Supabase Project URL
# Found in: Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon (Public) Key
# Found in: Settings → API → Project API keys → anon public
# This key is safe to use in the browser if Row Level Security is enabled
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Service Role Secret (for backend only, NEVER expose to browser)
# Found in: Settings → API → Project API keys → service_role
# Only use this in backend code, NEVER in client-side code
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
